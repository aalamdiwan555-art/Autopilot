<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_logo_mark"
                android:gravity="center"
                android:text="MB"
                android:textColor="@color/ink_950"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAMA BHUTNIKA"
                    android:textColor="@color/brand_mint"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your ride desk"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status"
            android:padding="18dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTOMATION STATUS"
                android:textColor="@color/brand_mint"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking your ride desk..."
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subscription status is loading..."
            android:textColor="@color/brand_amber"
            android:textSize="13sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep your access active"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Watch rewarded videos to build a free day when your subscription ends."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvRewardProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ads watched: 0 / 10"
                android:textColor="@color/brand_mint"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnWatchAd"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Watch a rewarded video"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_blue"
                android:textColor="@color/ink_950" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invite a driver"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReferralCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your referral code is loading..."
                android:textColor="@color/brand_mint"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnShareReferral"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Share my code"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/ink_700"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etReferralCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter a friend's code"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnRedeemReferral"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Redeem code"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_mint"
                android:textColor="@color/ink_950" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/toggleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable auto-click"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only supported ride-driver apps are scanned. You stay in control."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a driver app"
                android:textColor="@color/brand_mint"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/rapidoModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rapido Captain"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/olaModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ola Driver"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/uberModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uber Driver"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One-time setup"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable accessibility once. Overlay permission is only needed for the floating control."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/openSettingsBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Open accessibility settings"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_mint"
                android:textColor="@color/ink_950"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/overlayBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Grant overlay permission"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_amber"
                android:textColor="@color/ink_950"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/floatingBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Open floating controls"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_blue"
                android:textColor="@color/ink_950" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advanced matching"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/targetPackageInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Target package (optional)"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/customTextInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Custom labels, separated by commas"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Save matching settings"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/ink_700"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Sign out"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/ink_700"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supports Indian languages and English. Automation may be restricted by ride-platform terms."
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</ScrollView>