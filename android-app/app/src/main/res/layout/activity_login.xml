<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/tvLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_autopilot_mark"
            android:contentDescription="Autopilot logo"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTOPILOT"
            android:textColor="@color/brand_mint"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your next ride,\nwithout the scramble."
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A calm, always-ready assistant for Rapido, Ola, and Uber drivers."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:text="Welcome back"
                android:textColor="@color/text_primary"
                 android:textSize="20sp"
                android:textStyle="bold"
                 android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to open your ride desk."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="18dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                 android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                 android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot password?"
                android:textColor="@color/brand_mint"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_gravity="end"
                 android:layout_marginTop="-4dp"
                 android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Sign in"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_mint"
                android:textColor="@color/ink_950"
                 android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSignup"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create an account"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/ink_700"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTrialStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:text="Sign in to open your ride desk"
            android:textColor="@color/brand_amber"
            android:textSize="13sp"
            android:gravity="center"
             android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autopilot • v4.0"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>