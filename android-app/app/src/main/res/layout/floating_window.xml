<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="10dp"
    android:elevation="8dp">

    <TextView
        android:id="@+id/floatingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mama Bhutnika: OFF"
        android:textColor="@color/brand_mint"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:contentDescription="Drag floating controls"
        android:layout_marginBottom="3dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:text="START"
            android:textSize="10sp"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_mint"
            android:textColor="@color/ink_950"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:text="PAUSE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_amber"
            android:textColor="@color/ink_950"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:text="STOP"
            android:textSize="10sp"
            android:textStyle="bold"
            android:backgroundTint="@color/danger"
            android:textColor="@color/ink_950"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:text="X"
            android:textSize="10sp"
            android:textStyle="bold"
            android:backgroundTint="@color/ink_700"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>