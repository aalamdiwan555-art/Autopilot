<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="38dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/tvLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_autopilot_mark"
            android:contentDescription="Autopilot logo"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTOPILOT"
            android:textColor="@color/brand_mint"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:text="Get back on the road."
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:text="Enter your Autopilot email and we’ll send a secure reset link."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Send reset link"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_mint"
                android:textColor="@color/ink_950"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Back to sign in"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/ink_700"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_amber"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>