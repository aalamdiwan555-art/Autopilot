<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/autopilot_surface_raised" />
            <stroke android:width="1dp" android:color="@color/autopilot_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/autopilot_card" />
            <stroke android:width="1dp" android:color="@color/autopilot_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>